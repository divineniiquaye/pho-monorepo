{
  "name": "pho-monorepo",
  "version": "0.1.26",
  "bin": {
    "pho-monorepo": "scripts/init.mjs"
  },
  "files": [
    "scripts/init.mjs"
  ],
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "test": "node scripts/run.mjs test",
    "deps": "node scripts/deps.mjs",
    "patch": "pnpm dlx pnpm-patch-i",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "watchman": "watchman watch-del './' ; watchman watch-project './'",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "locale": "pnpm run --filter=@tooling/i18n locale"
  },
  "nohoist": [
    "**/expo-router",
    "**/expo-router/**"
  ],
  "dependencies": {
    "@inquirer/select": "^4.2.1",
    "chalk": "^5.4.1",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.3"
  },
  "engines": {
    "node": ">=20"
  },
  "i18n-config": {
    "paths": [
      "./apps/web",
      "./apps/native"
    ],
    "include": [
      "./packages/design-system/components"
    ]
  },
  "pnpm": {
    "patchedDependencies": {
      "@react-native/assets-registry": "patches/@react-native__assets-registry.patch",
      "react-native-bottom-sheet-manager": "patches/react-native-bottom-sheet-manager.patch"
    }
  }
}
